MODULE get_data_ip INPUT.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      input         = LV_SO
    IMPORTING
      OUTPUT        = LV_SO
            .

 SELECT vbeln posnr matnr INTO CORRESPONDING FIELDS OF table gt_vbap FROM vbap WHERE vbeln eq LV_SO.
ENDMODULE.

MODULE check_mat INPUT.
  data:lv_matnr TYPE mara-matnr.
  SELECT SINGLE matnr from mara INTO lv_matnr WHERE matnr = wa-matnr.
    IF lv_matnr is INITIAL.
      MESSAGE 'Material does bot exist in table' TYPE 'I'.
    ENDIF.
ENDMODULE.
